config {
  type: "table",
  schema: "silver",
  tags: ["silver"],
  columns: {
    id_assessment: "Assessment identifier",
    code_module: "Module identifier",
    code_presentation: "Presentation identifier",
    assessment_type: "TMA, CMA, or Exam",
    deadline_day: "Deadline day offset from course start",
    weight: "Assessment weight (0-100)",
    module_length: "Course length in days",
    weight_pct: "Weight as fraction of total per module-presentation",
  },
}

SELECT
  a.id_assessment,
  a.code_module,
  a.code_presentation,
  a.assessment_type,
  a.date AS deadline_day,
  a.weight,
  c.length AS module_length,
  ROUND(CAST(a.weight AS FLOAT64) / NULLIF(SUM(a.weight) OVER (
    PARTITION BY a.code_module, a.code_presentation
  ), 0), 4) AS weight_pct
FROM ${ref("bronze_assessments")} a
LEFT JOIN ${ref("bronze_courses")} c
  ON a.code_module = c.code_module
  AND a.code_presentation = c.code_presentation
