config {
  type: "table",
  schema: "dv",
  tags: ["dv", "hub"],
  assertions: {
    uniqueKey: ["hk_assessment"],
    nonNull: ["hk_assessment", "id_assessment"],
  },
}

SELECT DISTINCT
  TO_HEX(SHA256(CAST(id_assessment AS STRING))) AS hk_assessment,
  id_assessment,
  CURRENT_TIMESTAMP() AS dv_load_date,
  'OULAD' AS dv_source
FROM ${ref("bronze_assessments")}
