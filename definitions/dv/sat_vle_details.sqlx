config {
  type: "incremental",
  schema: "dv",
  tags: ["dv", "satellite"],
}

WITH sat_data AS (
  SELECT DISTINCT
    TO_HEX(SHA256(CAST(id_site AS STRING))) AS hk_vle,
    TO_HEX(SHA256(CONCAT(
      COALESCE(activity_type, ''), '|',
      COALESCE(CASE
        WHEN activity_type IN ('forumng', 'glossary') THEN 'communication'
        WHEN activity_type IN ('oucontent', 'htmlactivity', 'page', 'subpage') THEN 'content'
        WHEN activity_type IN ('quiz', 'externalquiz', 'questionnaire') THEN 'assessment'
        WHEN activity_type IN ('resource', 'url', 'folder', 'sharedsubpage') THEN 'reference'
        WHEN activity_type IN ('homepage', 'dataplus', 'dualpane', 'repeatactivity') THEN 'tool'
        ELSE 'other'
      END, ''), '|',
      COALESCE(CAST(week_from AS STRING), ''), '|',
      COALESCE(CAST(week_to AS STRING), '')
    ))) AS hk_hashdiff,
    activity_type,
    CASE
      WHEN activity_type IN ('forumng', 'glossary') THEN 'communication'
      WHEN activity_type IN ('oucontent', 'htmlactivity', 'page', 'subpage') THEN 'content'
      WHEN activity_type IN ('quiz', 'externalquiz', 'questionnaire') THEN 'assessment'
      WHEN activity_type IN ('resource', 'url', 'folder', 'sharedsubpage') THEN 'reference'
      WHEN activity_type IN ('homepage', 'dataplus', 'dualpane', 'repeatactivity') THEN 'tool'
      ELSE 'other'
    END AS activity_category,
    week_from,
    week_to
  FROM ${ref("bronze_vle")}
)
SELECT
  *,
  CURRENT_TIMESTAMP() AS dv_load_date,
  'OULAD' AS dv_source
FROM sat_data

${ when(incremental(), `WHERE NOT EXISTS (
  SELECT 1 FROM ${self()} t
  WHERE t.hk_vle = sat_data.hk_vle
  AND t.hk_hashdiff = sat_data.hk_hashdiff
)`) }
