config {
  type: "incremental",
  schema: "dv",
  tags: ["dv", "hub"],
  uniqueKey: ["hk_student"],
  assertions: {
    nonNull: ["hk_student", "id_student"],
  },
}

SELECT DISTINCT
  TO_HEX(SHA256(CAST(id_student AS STRING))) AS hk_student,
  id_student,
  CURRENT_TIMESTAMP() AS dv_load_date,
  'OULAD' AS dv_source
FROM ${ref("bronze_student_registration")}
