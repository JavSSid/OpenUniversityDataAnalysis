config {
  type: "table",
  schema: "dv",
  tags: ["dv", "txn"],
  assertions: {
    nonNull: ["hk_student", "hk_vle", "date"],
  },
}

SELECT
  TO_HEX(SHA256(CAST(id_student AS STRING))) AS hk_student,
  TO_HEX(SHA256(CAST(id_site AS STRING))) AS hk_vle,
  TO_HEX(SHA256(CONCAT(code_module, '|', code_presentation))) AS hk_course_offering,
  date,
  sum_click,
  CURRENT_TIMESTAMP() AS dv_load_date,
  'OULAD' AS dv_source
FROM ${ref("bronze_student_vle")}
