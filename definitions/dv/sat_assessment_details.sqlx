config {
  type: "incremental",
  schema: "dv",
  tags: ["dv", "satellite"],
}

WITH sat_data AS (
  SELECT DISTINCT
    TO_HEX(SHA256(CAST(id_assessment AS STRING))) AS hk_assessment,
    TO_HEX(SHA256(CONCAT(
      COALESCE(assessment_type, ''), '|',
      COALESCE(CAST(date AS STRING), ''), '|',
      COALESCE(CAST(weight AS STRING), '')
    ))) AS hk_hashdiff,
    assessment_type,
    date AS deadline_day,
    weight
  FROM ${ref("bronze_assessments")}
)
SELECT
  *,
  CURRENT_TIMESTAMP() AS dv_load_date,
  'OULAD' AS dv_source
FROM sat_data

${ when(incremental(), `WHERE NOT EXISTS (
  SELECT 1 FROM ${self()} t
  WHERE t.hk_assessment = sat_data.hk_assessment
  AND t.hk_hashdiff = sat_data.hk_hashdiff
)`) }
