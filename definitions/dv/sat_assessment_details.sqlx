config {
  type: "table",
  schema: "dv",
  tags: ["dv", "satellite"],
  assertions: {
    nonNull: ["hk_assessment"],
  },
}

SELECT
  hk_assessment,
  ANY_VALUE(assessment_type) AS assessment_type,
  ANY_VALUE(deadline_day) AS deadline_day,
  ANY_VALUE(weight) AS weight,
  CURRENT_TIMESTAMP() AS dv_load_date,
  'OULAD' AS dv_source
FROM (
  SELECT DISTINCT
    TO_HEX(SHA256(CAST(id_assessment AS STRING))) AS hk_assessment,
    assessment_type,
    date AS deadline_day,
    weight
  FROM ${ref("bronze_assessments")}
)
GROUP BY hk_assessment
