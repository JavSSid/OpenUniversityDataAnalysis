config {
  type: "table",
  schema: "dv",
  tags: ["dv", "satellite"],
  assertions: {
    nonNull: ["hk_assessment"],
  },
}

SELECT DISTINCT
  TO_HEX(SHA256(CAST(id_assessment AS STRING))) AS hk_assessment,
  assessment_type,
  date AS deadline_day,
  weight,
  CURRENT_TIMESTAMP() AS dv_load_date,
  'OULAD' AS dv_source
FROM ${ref("bronze_assessments")}
