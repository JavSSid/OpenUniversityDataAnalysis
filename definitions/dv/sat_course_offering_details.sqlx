config {
  type: "incremental",
  schema: "dv",
  tags: ["dv", "satellite"],
}

WITH sat_data AS (
  SELECT DISTINCT
    TO_HEX(SHA256(CONCAT(code_module, '|', code_presentation))) AS hk_course_offering,
    TO_HEX(SHA256(CONCAT(
      COALESCE(CAST(length AS STRING), ''), '|',
      COALESCE(CASE
        WHEN SUBSTR(code_presentation, -1) = 'B' THEN 'February'
        WHEN SUBSTR(code_presentation, -1) = 'J' THEN 'October'
        ELSE 'Unknown'
      END, '')
    ))) AS hk_hashdiff,
    length,
    CASE
      WHEN SUBSTR(code_presentation, -1) = 'B' THEN 'February'
      WHEN SUBSTR(code_presentation, -1) = 'J' THEN 'October'
      ELSE 'Unknown'
    END AS presentation_start
  FROM ${ref("bronze_courses")}
)
SELECT
  *,
  CURRENT_TIMESTAMP() AS dv_load_date,
  'OULAD' AS dv_source
FROM sat_data

${ when(incremental(), `WHERE NOT EXISTS (
  SELECT 1 FROM ${self()} t
  WHERE t.hk_course_offering = sat_data.hk_course_offering
  AND t.hk_hashdiff = sat_data.hk_hashdiff
)`) }
