config {
  type: "incremental",
  schema: "dv",
  tags: ["dv", "link"],
  uniqueKey: ["hk_student_assessment"],
  assertions: {
    nonNull: ["hk_student_assessment", "hk_student", "hk_assessment"],
  },
}

SELECT DISTINCT
  TO_HEX(SHA256(CONCAT(
    CAST(id_student AS STRING), '|',
    CAST(id_assessment AS STRING)
  ))) AS hk_student_assessment,
  TO_HEX(SHA256(CAST(id_student AS STRING))) AS hk_student,
  TO_HEX(SHA256(CAST(id_assessment AS STRING))) AS hk_assessment,
  CURRENT_TIMESTAMP() AS dv_load_date,
  'OULAD' AS dv_source
FROM ${ref("bronze_student_assessment")}
