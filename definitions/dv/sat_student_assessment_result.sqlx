config {
  type: "table",
  schema: "dv",
  tags: ["dv", "satellite"],
  assertions: {
    nonNull: ["hk_student_assessment"],
  },
}

SELECT
  hk_student_assessment,
  ANY_VALUE(date_submitted) AS date_submitted,
  ANY_VALUE(is_banked) AS is_banked,
  ANY_VALUE(score) AS score,
  CURRENT_TIMESTAMP() AS dv_load_date,
  'OULAD' AS dv_source
FROM (
  SELECT DISTINCT
    TO_HEX(SHA256(CONCAT(
      CAST(id_student AS STRING), '|',
      CAST(id_assessment AS STRING)
    ))) AS hk_student_assessment,
    date_submitted,
    is_banked,
    score
  FROM ${ref("bronze_student_assessment")}
)
GROUP BY hk_student_assessment
