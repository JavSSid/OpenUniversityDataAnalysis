config {
  type: "incremental",
  schema: "dv",
  tags: ["dv", "satellite"],
}

WITH sat_data AS (
  SELECT DISTINCT
    TO_HEX(SHA256(CONCAT(
      CAST(id_student AS STRING), '|',
      CAST(id_assessment AS STRING)
    ))) AS hk_student_assessment,
    TO_HEX(SHA256(CONCAT(
      COALESCE(CAST(date_submitted AS STRING), ''), '|',
      COALESCE(CAST(is_banked AS STRING), ''), '|',
      COALESCE(CAST(score AS STRING), '')
    ))) AS hk_hashdiff,
    date_submitted,
    is_banked,
    score
  FROM ${ref("bronze_student_assessment")}
)
SELECT
  *,
  CURRENT_TIMESTAMP() AS dv_load_date,
  'OULAD' AS dv_source
FROM sat_data

${ when(incremental(), `WHERE NOT EXISTS (
  SELECT 1 FROM ${self()} t
  WHERE t.hk_student_assessment = sat_data.hk_student_assessment
  AND t.hk_hashdiff = sat_data.hk_hashdiff
)`) }
