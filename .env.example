# ──────────────────────────────────────────────────────────────
# Open University Data Platform — GCP BigQuery Configuration
# ──────────────────────────────────────────────────────────────
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.
#
# In production, these values are stored in GCP Secret Manager
# under the oulad- prefix. See terraform/ for provisioning.

# ── GCP Project ─────────────────────────────────────────────
GCP_PROJECT_ID=oulad-platform
GCP_REGION=europe-west1
GCP_LOCATION=EU

# ── BigQuery Service Account (JSON key fields) ──────────────
BIGQUERY_PRIVATE_KEY_ID=
BIGQUERY_PRIVATE_KEY=
BIGQUERY_CLIENT_EMAIL=oulad-pipeline-sa@oulad-platform.iam.gserviceaccount.com
BIGQUERY_CLIENT_ID=
BIGQUERY_CLIENT_CERT_URL=

# ── Slack Webhook (for alerts) ─────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE_WITH_YOUR_WEBHOOK
SLACK_CHANNEL=#data-quality

# ── Secret Manager Secret Names (for runtime resolution) ───
# SECRET_SLACK_WEBHOOK=oulad-slack-webhook
# SECRET_BIGQUERY_KEY=oulad-bigquery-service-account

# ── Power BI ────────────────────────────────────────────────
# Connection via BigQuery connector:
#   Server: oulad-platform
#   Database: (leave blank)
#   Data Connectivity: Import (DirectQuery also works for <100MB)
#   Authentication: Service Principal / Service Account

# ── Environment ─────────────────────────────────────────────
ENVIRONMENT=dev
