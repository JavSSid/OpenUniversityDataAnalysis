config {
  type: "table",
  schema: "silver",
  tags: ["silver"],
  columns: {
    id_assessment: "Assessment identifier",
    id_student: "Student identifier",
    date_submitted: "Submission date offset",
    is_banked: "Flag: credit transfer (0 or 1)",
    score: "Assessment score (0-100, NULL if not submitted)",
    assessment_type: "TMA, CMA, or Exam",
    deadline_day: "Assessment deadline day offset",
    weight: "Assessment weight",
    assessment_result: "Derived: passed, failed, or not_submitted",
    submission_delay_days: "Days between deadline and submission (negative = early)",
  },
}

SELECT
  sa.id_assessment,
  sa.id_student,
  sa.date_submitted,
  sa.is_banked,
  sa.score,
  a.assessment_type,
  a.deadline_day,
  a.weight,
  CASE
    WHEN sa.score IS NULL THEN 'not_submitted'
    WHEN sa.score >= 40 THEN 'passed'
    ELSE 'failed'
  END AS assessment_result,
  sa.date_submitted - a.deadline_day AS submission_delay_days
FROM ${ref("bronze_student_assessment")} sa
LEFT JOIN ${ref("silver_assessments")} a
  ON sa.id_assessment = a.id_assessment
